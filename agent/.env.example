# Use UTF-8 for Aegra child processes on Windows.
PYTHONUTF8="1"

# Default model. Providers: openai, openrouter, anthropic, ollama, custom.
MODEL_PROVIDER="ollama"
MODEL_NAME="LiquidAI/lfm2.5-2.6b:q4_k_m"
# Ollama and custom providers use the OpenAI-compatible Chat Completions API.
# When the agent runs in Docker, use http://host.docker.internal:11434/v1 here.
MODEL_BASE_URL="http://127.0.0.1:11434/v1"
MODEL_API_KEY="ollama"

# Example for OpenRouter
# MODEL_PROVIDER="openrouter"
# MODEL_NAME="liquid/lfm-2.5-2.6b:free"
# MODEL_BASE_URL="https://openrouter.ai/api/v1"
# MODEL_API_KEY="your-openrouter-key"

# Existing Superset MCP endpoint used by the agent.
# When the agent runs in Docker and MCP runs on the host, use
# http://host.docker.internal:5008/mcp instead.
SUPERSET_MCP_URL="http://localhost:5008/mcp"
SUPERSET_DEFAULT_DATASET="wb_health_population"

# Optional. Leave empty when Superset MCP uses MCP_DEV_USERNAME. Set this to
# one user's key when Superset MCP API-key authentication is enabled.
SUPERSET_MCP_API_KEY=""

# Aegra server.
AEGRA_CONFIG="aegra.json"
AUTH_TYPE="noop"
HOST="0.0.0.0"
PORT="2026"
RUN_MIGRATIONS_ON_STARTUP="true"

# PostgreSQL used by Aegra.
POSTGRES_USER="superset_agent"
POSTGRES_PASSWORD="superset_agent_secret"
POSTGRES_DB="superset_agent"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
DB_ECHO_LOG="false"

# Local development runs jobs in-process.
REDIS_BROKER_ENABLED="false"

# Used by tests/test_security.py. Must belong to the mcp_sales_na test user.
SUPERSET_MCP_API_KEY_SALES_NA=""
