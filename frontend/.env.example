# Copy this file to .env.local before running Next.js.
# Aegra backend used by the Next.js /api proxy.
LANGGRAPH_API_URL=http://localhost:2026
# Forwarded as `x-api-key`. Leave blank for local dev.
LANGCHAIN_API_KEY=
# Must match a key under "graphs" in ../agent/aegra.json.
NEXT_PUBLIC_LANGGRAPH_ASSISTANT_ID=superset_agent

# Optional server-only override for Default Model. Leave blank to use the
# agent's model configuration. To override, set all four values together.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=

# Optional legacy fallback for MODEL_API_KEY. When used without the other
# MODEL_* values, selects minimax/minimax-m3.1-flash:free through OpenRouter.
OPENROUTER_TESTING_API_KEY=
